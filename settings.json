{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus[1m]",
  "advisorModel": "opus",
  "effortLevel": "xhigh",
  "autoUpdatesChannel": "stable",
  "cleanupPeriodDays": 14,
  "autoMemoryEnabled": true,
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "github@claude-plugins-official": true
  },
  "attribution": {
    "commit": "Co-Authored-By: Claude Opus 4.7 (1M context) <noreply@anthropic.com>"
  },
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "300000",
    "BASH_MAX_TIMEOUT_MS": "900000"
  },
  "statusLine": {
    "type": "command",
    "command": "bash -lc 'exec \"$HOME/.claude/scripts/statusline.sh\"'",
    "padding": 0
  },
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(ls)", "Bash(ls *)",
      "Bash(pwd)",
      "Bash(which *)",
      "Bash(file *)",
      "Bash(wc *)",
      "Bash(date)", "Bash(date *)",
      "Bash(uname *)",
      "Bash(rg *)",
      "Bash(grep *)",
      "Bash(find . *)",
      "Bash(git status)", "Bash(git status *)",
      "Bash(git diff)", "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch)", "Bash(git branch -a)", "Bash(git branch -v)", "Bash(git branch --show-current)",
      "Bash(git remote)", "Bash(git remote -v)", "Bash(git remote show *)",
      "Bash(git blame *)",
      "Bash(git stash list)", "Bash(git stash show *)",
      "Bash(git rev-parse *)",
      "Bash(git ls-files *)",
      "Bash(git config *)",
      "Bash(git fetch)", "Bash(git fetch *)",
      "Bash(git pull --ff-only)", "Bash(git pull --ff-only *)",
      "Bash(gh pr list *)", "Bash(gh pr view *)", "Bash(gh pr diff *)", "Bash(gh pr checks *)", "Bash(gh pr status)",
      "Bash(gh issue list *)", "Bash(gh issue view *)",
      "Bash(gh run list *)", "Bash(gh run view *)",
      "Bash(brew list *)", "Bash(brew search *)", "Bash(brew info *)",
      "Bash(npm run *)", "Bash(pnpm run *)", "Bash(yarn *)",
      "Bash(npm test)", "Bash(npm test *)",
      "Bash(npx --no -- *)",
      "Bash(python -m pytest *)", "Bash(python3 -m pytest *)",
      "Bash(pytest)", "Bash(pytest *)",
      "Bash(uv run *)",
      "Bash(go test *)", "Bash(go vet *)", "Bash(go build *)",
      "Bash(cargo test *)", "Bash(cargo check *)", "Bash(cargo build *)",
      "Bash(make)", "Bash(make *)",
      "Bash(just)", "Bash(just *)",
      "Bash(tree *)",
      "Read(~/.claude/**)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(git rebase *)",
      "Bash(git checkout --*)",
      "Bash(git restore *)",
      "Bash(git clean *)",
      "Bash(git branch -D *)", "Bash(git branch -d *)",
      "Bash(gh pr create *)", "Bash(gh pr merge *)", "Bash(gh pr close *)",
      "Bash(gh release create *)", "Bash(gh release delete *)",
      "Bash(npm publish *)", "Bash(pnpm publish *)", "Bash(yarn publish *)",
      "Bash(cargo publish *)",
      "Bash(docker push *)", "Bash(docker rm *)", "Bash(docker rmi *)",
      "Bash(kubectl apply *)", "Bash(kubectl delete *)",
      "Bash(terraform apply *)", "Bash(terraform destroy *)",
      "Bash(rm -rf *)"
    ],
    "deny": [
      "Read(./.env)", "Read(./.env.*)",
      "Read(./**/.env)", "Read(./**/.env.*)",
      "Read(./secrets/**)", "Read(./**/secrets/**)",
      "Read(~/.aws/credentials)",
      "Read(~/.aws/config)",
      "Read(~/.ssh/id_*)",
      "Read(~/.ssh/*_rsa)",
      "Read(~/.ssh/*_ed25519)",
      "Read(~/.netrc)",
      "Read(~/.zsh_history)",
      "Read(~/.bash_history)",
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)", "Bash(rm -rf ~/*)",
      "Bash(rm -rf $HOME*)",
      "Bash(git push --force * main*)", "Bash(git push -f * main*)",
      "Bash(git push --force * master*)", "Bash(git push -f * master*)",
      "Bash(git push --force-with-lease * main*)", "Bash(git push --force-with-lease * master*)",
      "Bash(sudo *)",
      "Bash(curl * | sh)", "Bash(curl * | bash)",
      "Bash(wget * | sh)", "Bash(wget * | bash)",
      "Bash(dd *)",
      "Bash(mkfs *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash -lc 'exec \"$HOME/.claude/scripts/hooks/format-on-edit.sh\"'",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -lc 'exec \"$HOME/.claude/scripts/hooks/stop-validator.sh\"'",
            "timeout": 90
          }
        ]
      }
    ]
  }
}
